# EOU Bond Tracker settings. start.bat copies this file to .env on first run.
# Edit .env (not this file) in Notepad, then restart the app.

# ---------------------------------------------------------------------------
# BACKUPS - the most important setting.
# Put backups in a folder that is NOT lost when this PC is formatted:
# your OneDrive / Google Drive / Dropbox folder or a network drive. Examples:
#   BACKUP_DIR=F:\Cloud Data\OneDrive\EOU Bond Tracker Backups
#   BACKUP_DIR=\\fileserver\accounts\eou-backups
# Blank = the "backups" folder inside this program folder. If the program
# folder is not synced, set BACKUP_DIR to a OneDrive/network folder.
BACKUP_DIR=
# Automatic backup every N hours while the app runs, keeping the newest N files
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=60

# ---------------------------------------------------------------------------
# DATABASE - leave blank to use SQLite at
#   %LOCALAPPDATA%\EOU Bond Tracker\eoubond.db
# which is on this PC only, deliberately OUTSIDE OneDrive (syncing a live
# database can corrupt it). The backups are what travel via OneDrive.
# EOU_DATA_DIR=  (to keep the database and secret key in another local folder)
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://eoubond:secret@localhost:5432/eoubond
DATABASE_URL=

# ---------------------------------------------------------------------------
# WEB SERVER
# HOST=127.0.0.1 -> only this PC.  HOST=0.0.0.0 -> other PCs on the office
# network can open http://<this-pc-name>:5000 (allow it in Windows Firewall).
HOST=127.0.0.1
PORT=5000
# Leave blank: a random key is generated once and kept in the data folder
SECRET_KEY=
# 1 only when the app is served over HTTPS (cloud)
SESSION_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# BRANDING (header). Leave BRAND_CREDIT blank to hide the credit box.
BRAND_NAME=EOU Bond Tracker
BRAND_TAGLINE=Duty-saved inventory under bond
BRAND_MARK=EOU
BRAND_CREDIT_LABEL=Designed & developed by
BRAND_CREDIT=

# Optional: alternative business-rules file
# EOU_RULES_FILE=
#
# The local demo database (built with "python -m eoubond.cli seed-demo") has
# one login - username: admin   password: demo-admin-123 - local demo only.
